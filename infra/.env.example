# Cấu hình production, tạo bằng: ./infra/scripts/init-env.sh <domain> <email>
# File thật là infra/.env trên server: chmod 600, không commit, lưu một bản ở nơi an toàn.
# Mọi biến của apps/api/src/config/env.validation.ts đều đặt được ở đây.
# Giá trị không được chứa ký tự $ (Compose hiểu là biến).

DOMAIN=shop.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Chỉ dùng chữ và số: mật khẩu được ghép vào URL kết nối.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long

# Email thật (chưa đặt thì email không gửi được, API vẫn chạy).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=ShopFast <no-reply@example.com>

# Trợ lý AI (mặc định tắt).
# LLM_PROVIDER=disabled
# LLM_API_KEY=
# LLM_MODEL=
