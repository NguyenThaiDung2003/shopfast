# Image nginx chính thức envsubst file này thành conf.d/default.conf; chỉ thay biến có trong
# environment (DOMAIN), các biến Nginx như $host giữ nguyên.

# DNS nội bộ của Docker, cho `server ... resolve` trong upstream.
resolver 127.0.0.11 valid=10s ipv6=off;

# Trỏ tới api-blue hoặc api-green; đổi bằng infra/scripts/switch-upstream.sh.
include /etc/nginx/upstream/active.conf;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_types application/javascript application/json image/svg+xml text/css text/plain;

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01: certbot ghi vào webroot này (cả lần cấp đầu và gia hạn).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    include /etc/nginx/snippets/api.conf;

    # File có hash trong tên: cache vĩnh viễn. Thiếu file thì 404, không trả index.html.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: route phía client trả index.html, không cache để nhận bản mới ngay sau deploy.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
