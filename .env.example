# Sao chép thành .env ở gốc repo rồi thay mọi giá trị "change-me".
# File .env đã bị gitignore – KHÔNG commit giá trị thật.
# Dùng chung cho docker compose và cho api khi chạy trực tiếp trên máy host.
# Mật khẩu chỉ nên gồm chữ và số để không phải URL-encode trong DATABASE_URL/REDIS_URL.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (container postgres) ---
POSTGRES_USER=shopfast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopfast

# --- Redis (container redis) ---
REDIS_PASSWORD=change-me

# --- Kết nối khi chạy api/prisma/seed từ máy host (qua cổng dev 127.0.0.1) ---
# Dùng 127.0.0.1, KHÔNG dùng localhost: trên Windows localhost phân giải ra ::1 (IPv6) trước,
# trong khi Docker chỉ bind IPv4 → mỗi connection mới của Prisma chậm ~2 giây.
# Trong container, docker-compose.yml tự dựng URL trỏ tới service postgres/redis.
DATABASE_URL=postgresql://shopfast:change-me@127.0.0.1:5432/shopfast?schema=public
REDIS_URL=redis://:change-me@127.0.0.1:6379

# --- Bảo mật ứng dụng ---
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# --- Xác thực (đều có giá trị mặc định, chỉ đặt khi muốn đổi) ---
# JWT_ACCESS_TTL=15m          # thời hạn access token: <số><s|m|h|d>
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_ROUNDS=12            # 4-15; càng cao càng chậm và an toàn
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# --- Tài liệu API (Swagger) tại /docs – đặt false nếu không muốn công khai ---
# SWAGGER_ENABLED=true

# --- Redis & cache catalog (F04, ADR-0007) – đều có mặc định ---
# REDIS_COMMAND_TIMEOUT_MS=100      # lệnh Redis quá hạn → bỏ qua cache, đọc DB
# CACHE_ENABLED=true
# CACHE_PRODUCT_TTL_SECONDS=300     # chi tiết sản phẩm (cộng/trừ jitter 15%)
# CACHE_LIST_TTL_SECONDS=60         # danh sách có lọc
# CACHE_NEGATIVE_TTL_SECONDS=30     # id không tồn tại

# --- Rate limit & khoá đăng nhập (F03, ADR-0008) – đều có mặc định ---
# TRUST_PROXY=false                 # số proxy đứng trước API; sau Nginx đặt 1 (compose đặt sẵn)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL=300/60          # <số request>/<giây>, mỗi user (đã đăng nhập) hoặc IP, toàn API
# RATE_LIMIT_LOGIN=10/60            # POST /auth/login, theo IP
# RATE_LIMIT_OTP_SEND=3/300         # POST /auth/otp/send, theo IP
# RATE_LIMIT_PROMO_ORDER=5/60       # POST /orders, theo user
# LOGIN_MAX_FAILED_ATTEMPTS=5       # sai liên tiếp (theo email) trước khi khoá
# LOGIN_FAILURE_WINDOW_SECONDS=900  # cửa sổ đếm số lần sai
# LOGIN_LOCKOUT_STEPS_SECONDS=60,300,1800  # khoá tăng dần, bước cuối lặp lại

# --- Background jobs (F05, ADR-0009) – đều có mặc định ---
# QUEUE_WORKERS_ENABLED=true        # false = instance chỉ phục vụ API (vẫn đẩy job)
# QUEUE_PREFIX=bull                 # tiền tố key Redis của BullMQ
# QUEUE_BACKOFF_BASE_MS=2000        # nền backoff exponential khi job lỗi
# PAYMENT_REMINDER_DELAY_MS=1800000 # nhắc thanh toán sau 30 phút
# SMTP_HOST=localhost               # compose đặt mailpit; production: SMTP thật
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=ShopFast <no-reply@shopfast.local>
# INVOICE_STORAGE_DIR=./storage/invoices  # compose: volume invoices → /data/invoices
# PARTNER_FAILURE_RATE=0.3          # tỉ lệ lỗi của API đối tác giả lập (0–1), demo retry
# PARTNER_LATENCY_MS=200
# REPORT_TIMEZONE=Asia/Ho_Chi_Minh  # lịch báo cáo 0h và cách tính "hôm qua"

# --- Realtime WebSocket (F02, ADR-0010) – có mặc định ---
# WS_MAX_SUBSCRIPTIONS=50           # số đơn tối đa một kết nối được theo dõi cùng lúc

# --- Support & trợ lý AI (F06, ADR-0011) ---
# disabled: ticket vẫn tạo được, phân loại = KHAC, /assistant trả 503.
LLM_PROVIDER=disabled               # anthropic | openai | google | disabled
LLM_API_KEY=                        # bắt buộc khi LLM_PROVIDER khác disabled – KHÔNG commit khoá thật
# LLM_MODEL=                        # anthropic mặc định claude-opus-5-5; openai/google bắt buộc (vd gemini-3.8-flash)
# LLM_BASE_URL=                     # tuỳ chọn: gateway/proxy hoặc endpoint tương thích OpenAI (google có sẵn mặc định)
# LLM_TIMEOUT_MS=20000              # mỗi lời gọi LLM
# AGENT_MAX_TOOL_ROUNDS=5           # số vòng gọi model tối đa mỗi lượt hỏi trợ lý
# AGENT_TIMEOUT_MS=45000            # tổng thời gian một lượt hỏi trợ lý
# RATE_LIMIT_AI_ASSISTANT=20/60     # POST /support/tickets/:id/assistant, theo user
# RATE_LIMIT_TICKET_CREATE=5/300    # POST /support/tickets, theo user

# --- Health check & tắt êm (ADR-0012) – có mặc định ---
# HEALTH_CHECK_TIMEOUT_MS=1000      # giới hạn mỗi kiểm tra DB/Redis của GET /health
# SHUTDOWN_DRAIN_MS=5000            # khi tắt: /health trả 503 trong khoảng này để load balancer rút traffic
# SHUTDOWN_TIMEOUT_MS=25000         # giới hạn cứng cả quá trình tắt (compose stop_grace_period phải lớn hơn)

# --- E2E test (pnpm test:e2e) – DB/Redis riêng, sẽ bị XOÁ SẠCH mỗi lần chạy ---
# Tên DB bắt buộc kết thúc bằng _test. Prisma tự tạo DB nếu chưa có.
TEST_DATABASE_URL=postgresql://shopfast:change-me@127.0.0.1:5432/shopfast_test?schema=public
TEST_REDIS_URL=redis://:change-me@127.0.0.1:6379/1

# --- Seed dữ liệu mẫu ---
# Mật khẩu chung cho mọi tài khoản mẫu (>= 8 ký tự). Chỉ dùng ở dev.
SEED_USER_PASSWORD=change-me

# --- Cổng publish ra host (tuỳ chọn, chỉ bind 127.0.0.1) ---
# API_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
