# Gốc REST API. Mặc định /api (dev đi qua proxy Vite tới http://localhost:3000).
# Khi API ở domain khác: https://api.shopfast.example/api (cần bật CORS phía API).
VITE_API_BASE_URL=/api

# Kênh liên hệ hiển thị ở trang Hỗ trợ (/ho-tro). Bỏ trống biến nào thì ẩn thẻ đó.
# Giá trị dưới đây là ví dụ, thay bằng thông tin thật trước khi triển khai.
VITE_SUPPORT_HOTLINE=1900 1234
VITE_SUPPORT_HOTLINE_HOURS=8:00 - 21:00 hằng ngày
VITE_SUPPORT_EMAIL=support@shopfast.example
VITE_SUPPORT_CHAT_URL=
VITE_SUPPORT_CHAT_NAME=ShopFast Vietnam
