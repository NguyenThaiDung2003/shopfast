// Schema Prisma của ShopFast. Lý do chọn Prisma: docs/adr/0001-chon-orm-prisma.md
// Quyết định mô hình dữ liệu (tiền, khoá chính, ràng buộc): docs/adr/0002-mo-hinh-du-lieu-va-moi-truong-dev.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT
  WAREHOUSE
  ADMIN
}

/// Chuyển trạng thái hợp lệ: src/modules/orders/order-status.machine.ts (ADR-0006).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders        Order[]
  refreshTokens RefreshToken[]
  cartItems     CartItem[]
  statusChanges OrderStatusHistory[]

  @@map("users")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products Product[]

  @@map("categories")
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products Product[]

  @@map("brands")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  slug        String   @unique
  description String?
  /// Giá bán, đơn vị đồng (VND), số nguyên. CHECK price >= 0 trong migration.
  price       Int
  /// Tồn kho thực tế. CHECK stock >= 0 trong migration – chặn bán vượt ở tầng DB.
  stock       Int      @default(0)
  categoryId  Int      @map("category_id")
  brandId     Int      @map("brand_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  brand      Brand       @relation(fields: [brandId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  // Index cho truy vấn catalog (lý do: ADR-0002 mục Index).
  @@index([categoryId, price])
  @@index([brandId, price])
  @@index([price])
  @@index([createdAt(sort: Desc), id])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  /// Mã đơn hiển thị cho khách, ví dụ SF-000001. Sinh từ sequence order_code_seq (migration cart_and_order).
  code           String      @unique @default(dbgenerated("('SF-'::text || lpad((nextval('order_code_seq'::regclass))::text, 6, '0'::text))"))
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  /// Tổng tiền, đơn vị đồng (VND).
  totalAmount    Int         @map("total_amount")
  paidAt         DateTime?   @map("paid_at")
  /// Header Idempotency-Key của request tạo đơn; unique theo user (ADR-0005).
  idempotencyKey String?     @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String @map("order_id") @db.Uuid
  productId Int    @map("product_id")
  /// CHECK quantity > 0 trong migration.
  quantity  Int
  /// Giá tại thời điểm đặt (VND), không đổi khi giá sản phẩm thay đổi.
  unitPrice Int    @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

/// Refresh token dạng chuỗi đục; chỉ lưu SHA-256. Cơ chế rotation/reuse detection: ADR-0003.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Mọi token sinh ra từ cùng một lần đăng nhập chung familyId.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Giỏ hàng của customer: mỗi dòng là một sản phẩm. CHECK quantity 1..99 trong migration.
model CartItem {
  userId    String   @map("user_id") @db.Uuid
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("cart_items")
}

/// Lịch sử chuyển trạng thái đơn – chỉ INSERT, không sửa/xoá (ADR-0006).
model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     String       @map("order_id") @db.Uuid
  /// null = lúc tạo đơn.
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String       @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum EmailDeliveryStatus {
  SENDING
  SENT
}

/// Sổ ghi email đã gửi (F05, ADR-0009): unique (kind, ref) → chạy lại job không gửi lần hai.
/// Worker "claim" dòng (SENDING) trước khi gửi, gửi xong chuyển SENT; gửi lỗi thì xoá claim.
model EmailDelivery {
  id        Int                 @id @default(autoincrement())
  /// Loại email: order-confirmation | payment-reminder | daily-revenue-report.
  kind      String
  /// Đối tượng: orderId, hoặc "<YYYY-MM-DD>:<adminId>" cho báo cáo ngày.
  ref       String
  recipient String
  status    EmailDeliveryStatus @default(SENDING)
  claimedAt DateTime            @default(now()) @map("claimed_at")
  sentAt    DateTime?           @map("sent_at")

  @@unique([kind, ref])
  @@map("email_deliveries")
}
